#starting equations
def Q_leak(Q_supply, Q_withdrawal)
  Leak = Q_supply - Q_withdrawal
  return Leak

def Pressure(P1, rho1, V1, z1)
  Bernoulli = P1 + (1/2 * rho1 * V1 * V1) + (rho1 * g * z1)
  return Bernoulli

